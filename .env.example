# Yerel bilgisayarda çalıştırmak için bu dosyayı ".env" adıyla kopyalayıp doldurun.
# GitHub Actions'ta bu değerler Settings > Secrets and variables > Actions bölümüne eklenir.
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
PEXELS_API_KEY=
PIXABAY_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
# İsteğe bağlı: tekliflere otomatik e-posta yanıtı (Gmail için uygulama şifresi)
SMTP_SUNUCU=smtp.gmail.com
SMTP_PORT=465
SMTP_KULLANICI=
SMTP_SIFRE=
# İsteğe bağlı: Google Search Console otomatik kaydı (python araclar/youtube_token_al.py arama)
GOOGLE_ARAMA_TOKEN=
# Tek tıkla yetki (isteğe bağlı): anahtarları GitHub Secrets'a sistem kendisi yazar.
# GitHub > Settings > Developer settings > Fine-grained token: yalnızca bu depo, izin 'Secrets: Read and write'.
GH_YONETICI_TOKEN=
# İsteğe bağlı: Google onayında yalnızca bu hesap kabul edilir
GOOGLE_HESAP=
# İsteğe bağlı: yeni video duyurusu (Telegram botu kanala yönetici olarak eklenmeli; Bluesky'de "uygulama şifresi")
TELEGRAM_BOT_TOKEN=
TELEGRAM_KANAL=
BLUESKY_KULLANICI=
BLUESKY_SIFRE=

# Ek ücretsiz yapay zekâ sağlayıcıları (Hibrit AI'daki anahtarlar; telefonda: otonom anahtar-aktar)
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# Evdeki PC'nin yapay zekâsı (Jormungand) — yalnızca Cloudflare Tunnel ile dışarı açıldıysa
JORMUNGAND_URL=
JORMUNGAND_TOKEN=
